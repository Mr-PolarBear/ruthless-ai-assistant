# ==============================================================================
# 智能摸鱼云同步服务 (sync-server) - Nginx 生产反向代理配置模版
# 适用场景：配合 Let's Encrypt / 腾讯云 SSL 证书，全链路启用 HTTPS
# ==============================================================================

# 1. HTTP 80 端口强制重定向至 HTTPS 443
server {
    listen 80;
    listen [::]:80;
    server_name sync.yourdomain.com; # 请替换为大爷的真实域名

    # 用于 Certbot 自动证书签发申请（如使用 certbot 申请 SSL）
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. HTTPS 443 核心代理站点
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sync.yourdomain.com; # 请替换为大爷的真实域名

    # — SSL 证书配置 (请替换为大爷服务器上的真实证书路径) —
    ssl_certificate /etc/nginx/ssl/sync.yourdomain.com.crt;
    ssl_certificate_key /etc/nginx/ssl/sync.yourdomain.com.key;

    # SSL 现代安全套件优化
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # — 关键生产优化 1：放开大快照上传限制 (默认 1M 极易导致 413 报错) —
    client_max_body_size 100M;
    client_body_buffer_size 128k;

    # — 关键生产优化 2：适度放宽超时时间，杜绝大快照长请求断开 —
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8443;

        # — 关键生产优化 3：穿透真实客户端 IP (防范 XFF 伪造绕过限流) —
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # — 关键生产优化 4：开启大文件代理内存缓冲与磁盘溢出缓冲，解除高延迟移动客户端对 Go 后端的锁喉 —
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 16 1m;
        proxy_busy_buffers_size 2m;
        proxy_max_temp_file_size 100m;

        # 透传 HTTP Range 断点续传请求头
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_http_version 1.1;
    }
}
