@echo off
chcp 65001 >nul
title 生成云同步注册邀请码
cd /d "%~dp0"

echo =========================================================================
echo                   智能摸鱼云同步 - 生成注册邀请码
echo =========================================================================
echo.
echo [提示] 可选输入该邀请码的备注说明（如：发给张三、自己备用）；
echo        若不需要备注，请直接按【回车键】跳过。
echo.
set /p note=请输入备注说明（可直接回车）: 

echo.
if "%note%"=="" (
    "%~dp0sync-server.exe" invite create
) else (
    "%~dp0sync-server.exe" invite create -note="%note%"
)

echo.
echo =========================================================================
echo  提示: 请选中并复制上方生成的 32 位邀请码。
echo  在网页端点击顶栏【云同步】图标，选择【凭邀请码注册】粘贴即可！
echo =========================================================================
echo.
pause
